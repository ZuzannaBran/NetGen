rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isOwnerForCreate() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /contacts/{contactId} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner();
    }

    match /events/{eventId} {
      allow read: if isOwner();
      allow create: if isOwnerForCreate();
      allow update: if isOwner() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner();
    }
  }
}
