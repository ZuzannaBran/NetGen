# URL of the deployed Firebase Function that proxies feedback emails
# Example: https://us-central1-your-project.cloudfunctions.net/sendFeedback
VITE_FEEDBACK_ENDPOINT=

# Firebase Web App config (client-side values; still visible in browser after build)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# EmailJS client config (public client identifiers, not server secrets)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
