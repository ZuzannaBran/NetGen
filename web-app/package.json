{
    "name": "netgen",
    "version": "1.0.0",
    "description": "Contact and professional networking manager built with Vite and Firebase",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"vite.config.js\"",
        "format": "prettier --write \"src/**/*.{js,css,html}\" \"tests/**/*.js\" \"index.html\" \"vite.config.js\"",
        "test": "node --test tests/*.test.js"
    },
    "dependencies": {
        "d3-force": "^3.0.0",
        "firebase": "^10.7.1",
        "force-graph": "^1.43.5"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.3.3",
        "vite": "^5.4.21",
        "vite-plugin-pwa": "^0.17.4"
    }
}
